') center 46%/cover no-repeat;
}
.hero::after{content:"";position:absolute;inset:0;background:linear-gradient(90deg,rgba(22,15,20,.18),transparent 26%,transparent 72%,rgba(22,15,20,.16));pointer-events:none}
.hero-inner{
  position:relative;z-index:2;width:min(1120px,calc(100% - 32px));margin:0 auto 34px;
  padding:32px 36px;background:rgba(255,250,246,.90);backdrop-filter:blur(9px);
  border:1px solid rgba(255,255,255,.52);box-shadow:0 24px 75px rgba(0,0,0,.28)
}
.eyebrow{font-size:10px;letter-spacing:.28em;color:var(--rose);text-transform:uppercase}
h1{font-size:clamp(50px,9vw,98px);line-height:.95;font-weight:500;letter-spacing:.06em;margin:8px 0 0}
h1 span{font-size:.3em;color:var(--rose);margin-left:.4em;letter-spacing:.13em}
.hero-copy{font-size:clamp(17px,2.2vw,25px);line-height:1.75;color:#60434d;margin:22px 0 0}
.hero-note{font-size:12px;color:#7c656d;margin-top:14px}
.jump-grid{display:grid;grid-template-columns:repeat(3,1fr);gap:8px;margin-top:22px}
.jump-grid button{
  border:1px solid #dfc7cc;background:rgba(255,255,255,.76);color:#60434d;
  padding:11px 10px;cursor:pointer;transition:.18s ease
}
.jump-grid button:hover{transform:translateY(-2px);border-color:var(--rose2);background:#fff}
.sticky-nav{
  position:sticky;top:0;z-index:50;background:rgba(25,18,23,.94);backdrop-filter:blur(10px);
  border-bottom:1px solid rgba(255,255,255,.08)
}
.sticky-inner{max-width:1120px;margin:auto;display:flex;gap:6px;overflow-x:auto;padding:9px 13px;scrollbar-width:none}
.sticky-inner::-webkit-scrollbar{display:none}
.nav-btn{
  border:0;background:transparent;color:#d9cbd0;white-space:nowrap;border-radius:999px;
  padding:8px 11px;font-size:12px;cursor:pointer;transition:.18s
}
.nav-btn.active,.nav-btn:hover{background:#5b3844;color:#fff}
main{max-width:1120px;margin:auto;background:var(--paper);padding:74px 6vw 110px}
.section{scroll-margin-top:72px;margin-bottom:86px}
.kicker{font-size:10px;letter-spacing:.24em;color:var(--rose);margin-bottom:7px}
h2{font-size:clamp(28px,4vw,40px);line-height:1.25;margin:0 0 24px}
h2::after{content:"";display:block;width:46px;height:2px;background:var(--rose2);margin-top:13px}
.intro{max-width:820px;font-size:18px}
.dialogue{margin:27px 0;padding:13px 20px;border-left:3px solid var(--rose);background:linear-gradient(90deg,#f9edef,transparent);font-size:25px;color:#74404c;font-style:italic}
.teaser{margin:27px 0;padding:20px 22px;background:#f7eeee;border:1px solid #ecd6db;color:#624852}
.teaser strong{color:#463038}
.world-grid{display:grid;grid-template-columns:repeat(3,1fr);gap:12px}
.world-card{background:#fff;border:1px solid var(--line);padding:19px;min-height:126px}
.world-card strong{display:block;color:var(--rose);font-size:17px;margin-bottom:6px}
.world-card em{font-style:normal;color:#a77b84;font-size:11px;margin-left:5px}
.world-card p{margin:0;font-size:14px;line-height:1.62}
.case-wrap{display:grid;grid-template-columns:1.3fr .7fr;gap:14px}
.case-main{padding:27px;background:linear-gradient(135deg,#fff,#f8f0f1);border:1px solid var(--line)}
.case-main h3{font-size:22px;margin:0 0 10px}
.case-main p{margin:0;font-size:15px}
.case-side{display:grid;gap:10px}
.case-side div{padding:18px;background:#fff;border:1px solid var(--line);border-top:2px solid var(--gold);font-size:14px}
.case-side b{display:block;color:var(--rose);margin-bottom:4px}
.character-grid{display:grid;gap:22px}
.character-card{background:#fff;border:1px solid var(--line);overflow:hidden;box-shadow:var(--shadow)}
.character-asset{height:210px;background-size:cover;background-position:center 38%;position:relative}
.asset-no{position:absolute;right:13px;top:12px;background:rgba(26,18,23,.65);color:#fff;padding:5px 8px;font-size:10px;letter-spacing:.16em}
.character-content{display:grid;grid-template-columns:185px 1fr;gap:25px;padding:0 26px 27px}
.portrait{width:185px;aspect-ratio:.684/1;object-fit:cover;object-position:center top;margin-top:-62px;border:6px solid #fff;box-shadow:0 12px 28px rgba(0,0,0,.16);position:relative;z-index:2}
.character-copy{padding-top:22px}
.character-copy h3{font-size:25px;margin:0;line-height:1.1}
.character-copy h3 small{display:block;font-size:11px;font-weight:400;color:var(--rose);letter-spacing:.1em;margin-top:6px}
.meta{font-size:12px;color:var(--muted);margin:8px 0 13px}
.character-copy p{margin:0;font-size:15px}
blockquote{margin:15px 0 0;padding:11px 13px;background:#faf1f2;border-left:2px solid var(--rose2);color:#68464f;font-size:14px}
.tags{display:flex;gap:6px;flex-wrap:wrap;margin-top:14px}
.tag{font-size:10px;border:1px solid #e7d2d7;border-radius:99px;padding:4px 8px;background:#fffafa;color:#73505a}
.play-grid{display:grid;grid-template-columns:repeat(3,1fr);gap:12px}
.play-card{padding:20px;background:var(--paper2);border-top:2px solid var(--rose2)}
.play-card h3{font-size:17px;margin:0 0 6px}
.play-card p{font-size:13px;margin:0}
.job-strip{margin-top:14px;padding:18px;background:#fff;border:1px solid var(--line)}
.job-list{display:flex;flex-wrap:wrap;gap:7px;margin-top:10px}
.job-list span{padding:6px 9px;background:#f6edef;color:#6a4b54;font-size:11px;border-radius:4px}
.persona-grid{display:grid;grid-template-columns:repeat(2,1fr);gap:13px}
.persona-card{position:relative;background:#fff;border:1px solid var(--line);padding:22px;min-height:220px}
.persona-index{position:absolute;right:16px;top:10px;font-size:29px;font-weight:700;color:#e0cdd1}
.persona-card h3{font-size:20px;margin:0 0 4px;color:#50363f}
.examples{font-size:11px;color:var(--rose);margin:0 0 17px;max-width:78%}
.persona-card dl{margin:0;display:grid;gap:9px}
.persona-card dl div{display:grid;grid-template-columns:45px 1fr;gap:8px;border-top:1px solid #f0e4e2;padding-top:8px}
.persona-card dt{font-size:11px;color:#8b6d75}
.persona-card dd{margin:0;font-size:12px;color:#5e4850}
.feature-list{display:grid;grid-template-columns:repeat(2,1fr);gap:7px 24px;list-style:none;padding:0;margin:0}
.feature-list li{position:relative;padding:9px 0 9px 20px;border-bottom:1px solid #eee1df;font-size:14px}
.feature-list li::before{content:"✦";position:absolute;left:0;color:var(--rose2)}
.closing{margin-top:58px;text-align:center;padding:34px 15px;border-top:1px solid var(--line);border-bottom:1px solid var(--line);font-size:19px;color:#704954}
.closing b{font-size:22px;color:#49323a}
.to-top{position:fixed;right:18px;bottom:18px;z-index:60;width:44px;height:44px;border-radius:50%;border:1px solid #e2cbd1;background:rgba(255,250,246,.94);color:#714955;box-shadow:0 10px 26px rgba(0,0,0,.13);cursor:pointer;opacity:0;pointer-events:none;transform:translateY(8px);transition:.2s}
.to-top.show{opacity:1;pointer-events:auto;transform:none}
.footer{background:var(--bg);color:#99878d;text-align:center;font-size:10px;padding:28px}
.reveal{opacity:0;transform:translateY(14px);transition:opacity .45s ease,transform .45s ease}
.reveal.on{opacity:1;transform:none}
.mobile-dock{display:none}
@media(max-width:900px){
  .world-grid,.play-grid{grid-template-columns:1fr 1fr}
  .case-wrap{grid-template-columns:1fr}
  .character-content{grid-template-columns:155px 1fr}
  .portrait{width:155px}
}
@media(max-width:680px){
  body{padding-bottom:64px}
  main{padding:54px 18px 76px}
  .hero-inner{padding:25px 21px;margin-bottom:18px}
  .jump-grid{grid-template-columns:repeat(2,1fr)}
  .jump-grid button:last-child{grid-column:auto}
  .sticky-nav{display:none}
  .world-grid,.play-grid,.persona-grid,.feature-list{grid-template-columns:1fr}
  .character-asset{height:150px}
  .character-content{display:block;padding:0 18px 23px}
  .portrait{width:128px;margin-top:-48px}
  .character-copy{padding-top:16px}
  .mobile-dock{
    display:flex;position:fixed;left:0;right:0;bottom:0;z-index:55;background:rgba(25,18,23,.96);
    backdrop-filter:blur(10px);padding:7px 8px calc(7px + env(safe-area-inset-bottom));
    gap:4px;border-top:1px solid rgba(255,255,255,.08)
  }
  .mobile-dock button{flex:1;border:0;background:transparent;color:#d9cbd0;font-size:10px;padding:8px 3px;border-radius:6px}
  .mobile-dock button.active{background:#5b3844;color:#fff}
  .to-top{bottom:76px}
}
@media(prefers-reduced-motion:reduce){html{scroll-behavior:auto}.reveal{opacity:1;transform:none;transition:none}}

.fragment-card{
  position:relative;
  overflow:hidden;
  border:1px solid var(--line);
  background:#fff;
  box-shadow:var(--shadow);
}
.fragment-image{
  width:100%;
  display:block;
  aspect-ratio:1216/190;
  object-fit:cover;
  object-position:center top;
}
.fragment-overlay{
  position:absolute;
  inset:0;
  background:linear-gradient(90deg,rgba(25,18,23,.08),transparent 38%,rgba(25,18,23,.08));
  pointer-events:none;
}
.fragment-caption{
  display:flex;
  align-items:center;
  justify-content:space-between;
  gap:18px;
  padding:16px 18px;
  border-top:1px solid var(--line);
  background:#fffaf8;
}
.fragment-caption strong{
  color:#5b3c47;
  font-size:15px;
}
.fragment-caption span{
  color:#876e76;
  font-size:12px;
  text-align:right;
}
.fragment-warning{
  margin-top:10px;
  color:#9a7d85;
  font-size:11px;
}
@media(max-width:680px){
  .fragment-caption{
    display:block;
  }
  .fragment-caption span{
    display:block;
    text-align:left;
    margin-top:5px;
  }
}

</style>
</head>
<body>

<section class="hero" id="top">
  <div class="hero-inner">
    <div class="eyebrow">ORIENTAL PERIOD DRAMA · POLITICAL MYSTERY · ROMANCE TRPG</div>
    <h1>삼생화 <span>三生花</span></h1>
    <div class="hero-copy">“세 번의 봄, 같은 인연, 다른 결말.<br>꽃은 세 번 피었고, 우리는 매번 서로를 다르게 사랑했다.”</div>
    <div class="hero-note">성인 자유 페르소나 · 주요 성인 NPC 6인 관계/로맨스 가능 · 생활/사건/관계 자유 진행</div>
    <div class="jump-grid">
      <button data-target="intro">도입</button>
      <button data-target="fragment">기억의 파편</button>
      <button data-target="world">세계관</button>
      <button data-target="cast">등장인물</button>
      <button data-target="persona">추천 페르소나</button>
      <button data-target="play">플레이 특징</button>
    </div>
  </div>
</section>

<nav class="sticky-nav" aria-label="빠른 이동">
  <div class="sticky-inner">
    <button class="nav-btn active" data-target="intro">도입</button>
    <button class="nav-btn" data-target="frag